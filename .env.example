# 이 파일은 선택입니다. 보통은 도우미 화면의 "설정" 탭에서 입력하면 됩니다.
# 여기에 값을 넣으면 설정 화면 값보다 우선합니다.

# 쓸 AI: claude 또는 gemini
# BLOG_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# Claude API 키 (https://console.anthropic.com 에서 발급)
# ANTHROPIC_API_KEY=sk-ant-...

# 사용할 모델 (기본값: claude-opus-5-5)
# BLOG_MODEL=claude-opus-5-5

# 블로그 기본 정보 — 화면에서 매번 입력하지 않아도 되도록 기본값으로 사용됩니다.
# BLOG_NAME=우리가게 공식 블로그
# BLOG_INDUSTRY=카페
# BLOG_TONE=친근하고 따뜻한 말투, ~해요체

# "네이버 에디터로 보내기"를 누르면 열리는 글쓰기 주소.
# 기본값은 로그인한 계정의 블로그 글쓰기 화면입니다. 특정 블로그로 고정하려면
# https://blog.naver.com/<블로그아이디>?Redirect=Write 형태로 지정하세요.
# BLOG_WRITE_URL=https://blog.naver.com/GoBlogWrite.naver
